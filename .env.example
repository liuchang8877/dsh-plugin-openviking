# 复制成 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# 任何 OpenAI 兼容端点。注意必须有 embedding 模型，
# 否则 OpenViking 的 find / search 用不了，只剩 grep / glob。
export DASHSCOPE_API_KEY=sk-xxxx
export DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
export DASHSCOPE_LLM_MODEL=qwen-plus
export DASHSCOPE_EMBED_MODEL=qwen3.7-text-embedding
export DASHSCOPE_EMBED_DIM=1024
